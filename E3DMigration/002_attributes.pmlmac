!file           = object FILE('c:\temp\elementTypesAttributes.txt') 
!!output        = object ARRAY()

do !etype value !etypes
    !elmtype = object ELEMENTTYPE(!etype)
    !sysatts = !elmtype.SYSTEMATTRIBUTES()
    !udaatts = !elmtype.UDAS()

    do !sysatt value !sysatts
        !!output.append( !etype + | , | + !sysatt.name() + | , | + !sysatt.type() + | , | + !sysatt.length().string() )
    enddo
    do !udaatt value !udaatts
        !!output.append( !etype + | , | + !udaatt.name() + | , | + !udaatt.type() + | , | + !udaatt.length().string() )
    enddo

enddo

!file.WRITEFILE( |OVER| , !!output )